{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "node scripts/validate-vercel-env.mjs && pnpm --filter @workspace/api-server run build:vercel && PORT=3000 BASE_PATH=/ VITE_CLERK_AUTH_MODE=external pnpm --filter @workspace/technical-office run build",
  "outputDirectory": "artifacts/technical-office/dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "artifacts/api-server/dist-vercel/handler.cjs"
    }
  },
  "crons": [
    {
      "path": "/api/office/push/dispatch",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
